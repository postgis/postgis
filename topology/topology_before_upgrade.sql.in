CREATE OR REPLACE FUNCTION _postgis_topology_upgrade_domain_type(
  domain_name text,
  old_domain_type text,
  new_domain_type text,
  deprecated_in_version text
) RETURNS void AS $$
DECLARE
  domain_oid oid;
  domain_array_oid oid;
  domain_column record;
  indirect_carriers text;
BEGIN
  SELECT t.oid, t.typarray
  INTO domain_oid, domain_array_oid
  FROM pg_catalog.pg_type AS t
  WHERE t.typnamespace = 'topology'::regnamespace
    AND t.typname = domain_name
    AND t.typbasetype IN (old_domain_type::regtype, new_domain_type::regtype);

  IF NOT FOUND THEN
    RETURN;
  END IF;

  UPDATE pg_catalog.pg_type
  SET typbasetype = new_domain_type::regtype,
      typndims = (pg_catalog.length(new_domain_type) -
                  pg_catalog.length(pg_catalog.replace(new_domain_type, '[]', ''))) / 2
  WHERE oid = domain_oid;

  FOR domain_column IN
    SELECT a.attrelid, a.attname
    FROM pg_catalog.pg_attribute AS a
    JOIN pg_catalog.pg_class AS c ON c.oid = a.attrelid
    WHERE a.atttypid = domain_oid
      AND a.attnum > 0 AND NOT a.attisdropped
      AND c.relkind IN ('r', 'p')
  LOOP
    EXECUTE pg_catalog.format(
      'UPDATE ONLY %s SET %I = %I::text::topology.%I',
      domain_column.attrelid::regclass,
      domain_column.attname,
      domain_column.attname,
      domain_name
    );
  END LOOP;

  SELECT pg_catalog.string_agg(carrier, ', ')
  INTO indirect_carriers
  FROM (
    SELECT DISTINCT pg_catalog.format('%s.%I', a.attrelid::regclass, a.attname) AS carrier
    FROM pg_catalog.pg_attribute AS a
    JOIN pg_catalog.pg_class AS c ON c.oid = a.attrelid
    JOIN pg_catalog.pg_type AS t ON t.oid = a.atttypid
    WHERE a.attnum > 0 AND NOT a.attisdropped
      AND (a.atttypid = domain_array_oid OR t.typelem = domain_oid
        OR t.typbasetype = domain_oid
        OR (c.relkind = 'm' AND a.atttypid = domain_oid)
        OR (t.typtype = 'c' AND EXISTS (
          SELECT 1 FROM pg_catalog.pg_attribute AS ca
          WHERE ca.attrelid = t.typrelid AND ca.atttypid = domain_oid
            AND ca.attnum > 0 AND NOT ca.attisdropped
        )))
  ) AS carriers;

  IF indirect_carriers IS NOT NULL THEN
    RAISE WARNING 'Topology.% has indirect domain carriers that were not rewritten: %',
      domain_name, indirect_carriers;
  END IF;
END;
$$ LANGUAGE plpgsql;


-- These are functions where the argument names may have changed  --
-- so have to be dropped before upgrade can happen for 9.0+ --
-- argument names changed --
-- we might want to take toTopoGeom one out before release since
-- I don't think too many people installed the bad name
SELECT _postgis_drop_function_by_signature('topology.toTopoGeom(Geometry, varchar, int, float8)', 'xxx');

-- used to be in public, will now be moved to topology
SELECT _postgis_drop_function_by_signature('public.postgis_topology_scripts_installed()', 'xxx');

-- Removed in 2.2.0 when topology API moved to liblwgeom
SELECT _postgis_drop_function_by_signature('topology._ST_RemEdgeCheck(varchar, integer, integer, integer, integer)', '2.2.0');
-- Removed in 2.2.0 when topology API moved to liblwgeom
SELECT _postgis_drop_function_by_signature('topology._ST_AddFaceSplit(varchar, integer, integer, boolean)', '2.2.0');

-- Added optional bbox parameter in 3.2.0
SELECT _postgis_drop_function_by_signature('topology.validatetopology(varchar)', '3.2.0');

-- Merged the two function into one with both allowEdgeSplitting and setContainingFace parameters
-- being optional (3.2.0)
SELECT _postgis_drop_function_by_signature('topology.AddNode(varchar, geometry)', '3.2.0');
SELECT _postgis_drop_function_by_signature('topology.AddNode(varchar, geometry, boolean, boolean)', '3.2.0');

-- 3.6.0
-- Merged both and made child_id (integer) optional
SELECT _postgis_drop_function_by_signature('AddTopoGeometryColumn(varchar, varchar, varchar, varchar, varchar)', '3.6.0');
SELECT _postgis_drop_function_by_signature('AddTopoGeometryColumn(varchar, varchar, varchar, varchar, varchar, integer)', '3.6.0');
-- Merged all 4 functions and added optional topology_id and useslargeids
SELECT _postgis_drop_function_by_signature('topology.CreateTopology(varchar, integer, float8, boolean)', '3.6.0');
SELECT _postgis_drop_function_by_signature('topology.CreateTopology(varchar, integer, float8)', '3.6.0');
SELECT _postgis_drop_function_by_signature('topology.CreateTopology(varchar, integer)', '3.6.0');
SELECT _postgis_drop_function_by_signature('topology.CreateTopology(varchar)', '3.6.0');
-- Upgrade casts, domains, and types from integer to bigint
SELECT _postgis_drop_cast_by_types('topogeometry', 'integer[]', '3.6.0');
SELECT _postgis_add_column_to_table('topology.topology'::regclass, 'useslargeids'::name, 'BOOLEAN'::text, true, 'false'::text, '3.6.0'::text);

-- 3.7.0
-- Return edge identifiers as bigint instead of integer
DO $postgis_upgrade$
DECLARE
	old_result text;
BEGIN
	old_result := pg_catalog.pg_get_function_result('topology.findVertexSegmentPairsBelowDistance(varchar, float8)'::regprocedure);
	IF old_result LIKE '%seg_edge integer%' AND old_result LIKE '%vert_edge integer%' THEN
		PERFORM _postgis_drop_function_by_signature('topology.findVertexSegmentPairsBelowDistance(varchar, float8)', '3.7.0');
	END IF;
EXCEPTION
	WHEN undefined_function THEN
		NULL;
END
$postgis_upgrade$;
