-- Remove retired overloads when possible. Preserve the function OID if
-- a dependent object needs it, and remove the old name from resolution.
DO LANGUAGE plpgsql $$
DECLARE
	signature text;
	old_function pg_catalog.regprocedure;
	old_name text;
BEGIN
	FOREACH signature IN ARRAY ARRAY[
		'topology.toTopoGeom(Geometry, varchar, int, float8)',
		'postgis_topology_scripts_installed()',
		'topology._ST_RemEdgeCheck(varchar, integer, integer, integer, integer)',
		'topology._ST_AddFaceSplit(varchar, integer, integer, boolean)',
		'topology.validatetopology(varchar)',
		'topology.AddNode(varchar, geometry)',
		'topology.AddNode(varchar, geometry, boolean, boolean)'
	] LOOP
		old_function := pg_catalog.to_regprocedure(signature);
		IF old_function IS NULL THEN
			CONTINUE;
		END IF;
		BEGIN
			EXECUTE pg_catalog.format('DROP FUNCTION %s', old_function);
		EXCEPTION WHEN dependent_objects_still_exist THEN
			SELECT proname INTO STRICT old_name
			FROM pg_catalog.pg_proc WHERE oid = old_function;
			EXECUTE pg_catalog.format('ALTER FUNCTION %s RENAME TO %I',
				old_function, old_name || '_deprecated_by_postgis');
			RAISE WARNING 'Preserving retired topology function % for dependent objects', signature;
		END;
	END LOOP;
END
$$;
