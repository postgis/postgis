# This file should be included by the Makefile
# in each language directory

local-all: local-html comments

local-html: symlinks
	$(MAKE) html

local-pdf: symlinks
	$(MAKE) pdf

local-check: symlinks
	$(MAKE) check

local-clean:
	rm -f $(XML_INPUTS)
	rm -f html xsl

symlinks:
	rm -f html; ln -s ../../html html
	rm -f xsl; ln -s ../../xsl xsl

# for XML_SOURCES
include ../../Makefile

# XML gettext tools
MSGATTRIB=msgattrib
PO2XML=po2xml

$(XML_SOURCES): %.xml: %.xml.po ../../%.xml
	$(MSGATTRIB) --no-fuzzy -o $@.po.tmp $<
	$(PO2XML) ../../$@ $@.po.tmp > $@.tmp
	mv $@.tmp $@
	rm -f $@.po.tmp

